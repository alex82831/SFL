// The toml package: the type zoo, tables in all their spellings, the errors
// the spec demands, and a stringify -> parse round trip.

import "lib/assert"
import "../packages/toml/main"

def _doc(lines1) = join(lines1, "\n")

// ------------------------------------------------------------------ basics

val basic = tomlParse(_doc([
  "# top comment",
  "title = \"TOML test\"   # inline comment",
  "count = 42",
  "big = 1_000_000",
  "neg = -17",
  "hexa = 0xDEADbeef",
  "octal = 0o755",
  "binary = 0b1101",
  "pi = 3.14",
  "exp = 5e2",
  "negf = -0.01",
  "yes = true",
  "no = false",
  "lit = 'C:\\no \\escapes'",
  "esc = \"line\\nnext\\ttab \\\"q\\\" \\u00E9\"",
  ""
]))
check("strings parse", basic.title, "TOML test")
check("integers parse", basic.count, 42)
check("underscores separate", basic.big, 1000000)
check("negatives parse", basic.neg, -17)
check("hex parses", basic.hexa, 3735928559)
check("octal parses", basic.octal, 493)
check("binary parses", basic.binary, 13)
check("floats parse", basic.pi, 3.14)
check("exponents parse", basic.exp, 500.0)
check("negative floats parse", basic.negf, -0.01)
check("booleans parse", [basic.yes, basic.no], [true, false])
check("literal strings keep backslashes", basic.lit, "C:\\no \\escapes")
check("basic strings unescape", basic.esc, "line\nnext\ttab \"q\" é")

check("inf parses", tomlParse("x = inf").x > 1e308, true)
check("nan parses", isNaN(tomlParse("x = nan").x), true)

// ---------------------------------------------------------- dates as strings

check("offset datetimes stay strings",
  tomlParse("d = 1979-05-27T07:32:00Z").d, "1979-05-27T07:32:00Z")
check("local dates stay strings", tomlParse("d = 1979-05-27").d, "1979-05-27")
check("local times stay strings", tomlParse("t = 07:32:00.999").t, "07:32:00.999")

// ------------------------------------------------------------------- arrays

val arrs = tomlParse(_doc([
  "nums = [1, 2, 3]",
  "mixed = [[1, 2], [\"a\"]]",
  "multi = [",
  "  10,   # one",
  "  20,",
  "]",
  "empty = []"
]))
check("arrays parse", arrs.nums, [1, 2, 3])
check("arrays nest", arrs.mixed, [[1, 2], ["a"]])
check("multi-line arrays allow comments and trailing commas", arrs.multi, [10, 20])
check("empty arrays parse", arrs.empty, [])

// ------------------------------------------------------------------- tables

val tables = tomlParse(_doc([
  "root = 1",
  "",
  "[server]",
  "host = \"localhost\"",
  "port = 8080",
  "",
  "[server.tls]",
  "enabled = true",
  "",
  "[owner.\"first last\"]",
  "ok = true",
  "",
  "[dotted]",
  "a.b.c = 3"
]))
check("root keys stay on the root", tables.root, 1)
check("tables nest", tables.server.host, "localhost")
check("subtables nest deeper", tables.server.tls.enabled, true)
check("quoted keys carry spaces", tables.owner["first last"].ok, true)
check("dotted keys build tables", tables.dotted.a.b.c, 3)

val inline = tomlParse("point = {x = 1, y = -2, label = \"p\"}")
check("inline tables parse", inline.point, {x: 1, y: -2, label: "p"})

val aot = tomlParse(_doc([
  "[[fruit]]",
  "name = \"apple\"",
  "",
  "[fruit.geometry]",
  "shape = \"round\"",
  "",
  "[[fruit]]",
  "name = \"banana\"",
  "",
  "[[fruit.variety]]",
  "name = \"plantain\""
]))
check("arrays of tables append", map(aot.fruit, (f) -> f.name), ["apple", "banana"])
check("subtables attach to the last element", aot.fruit[0].geometry.shape, "round")
check("nested table arrays attach too", aot.fruit[1].variety[0].name, "plantain")

// --------------------------------------------------------- multiline strings

val ml = tomlParse(_doc([
  "a = \"\"\"",
  "first",
  "second\"\"\"",
  "b = '''",
  "raw \\n kept'''",
  "c = \"\"\"one \\",
  "    two\"\"\""
]))
check("multi-line basic strings trim the first newline", ml.a, "first\nsecond")
check("multi-line literal strings keep escapes", ml.b, "raw \\n kept")
check("a line-ending backslash joins lines", ml.c, "one two")

// ------------------------------------------------------------------- errors

checkFails("duplicate keys are refused", () -> tomlParse(_doc(["a = 1", "a = 2"])),
  "duplicate key")
checkFails("redefined tables are refused",
  () -> tomlParse(_doc(["[t]", "a = 1", "[t]", "b = 2"])), "defined twice")
checkFails("values are not tables",
  () -> tomlParse(_doc(["a = 1", "[a.b]"])), "already a value")
checkFails("bare words are not values", () -> tomlParse("a = nope"), "not a TOML value")
checkFails("unclosed strings are caught", () -> tomlParse("a = \"oops"), "never closes")
checkFails("unclosed arrays are caught", () -> tomlParse("a = [1, 2"), "never closes")
checkFails("junk after a value is caught", () -> tomlParse("a = 1 b = 2"), "end of the line")
checkFails("misplaced underscores are caught", () -> tomlParse("a = 1__0"), "underscore")

// ---------------------------------------------------------------- stringify

check("scalars stringify", tomlStringify({n: 1, s: "x", f: 1.5, b: true}),
  "n = 1\ns = \"x\"\nf = 1.5\nb = true\n")
check("strings escape on the way out", tomlStringify({s: "a\"b\\c\nd"}),
  "s = \"a\\\"b\\\\c\\nd\"\n")
check("keys quote when they must", tomlStringify({"two words": 1}),
  "\"two words\" = 1\n")
checkFails("null has no TOML form", () -> tomlStringify({x: null}), "no null")

val round = {
  title: "app",
  limits: {cpu: 2, mem: 512, tags: ["a", "b"]},
  servers: [{host: "a", port: 1}, {host: "b", port: 2, tls: {on: true}}],
  point: {x: 1, y: 2}
}
check("stringify -> parse round trips", tomlParse(tomlStringify(round)), round)

val nested = {a: {b: {c: 1}}}
check("deep tables round trip", tomlParse(tomlStringify(nested)), nested)
check("empty tables round trip", tomlParse(tomlStringify({e: {}})), {e: {}})
check("inf and nan round trip",
  tomlParse(tomlStringify({i: 1.0 / 0.0})).i > 1e308, true)

report("toml")
