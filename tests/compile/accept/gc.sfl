// Allocates far more than the heap holds, from several threads at once, so the
// collector has to stop the world and find roots on stacks it does not own.
val ch = channel(16)
val workers = []
for (w in range(4)) {
  push(workers, spawn((id) -> {
    var local = 0
    for (i in range(8000)) {
      val o = {"id": id, "tag": "w" + id + "-" + i, "xs": [i, i + 1]}
      local += length(o.tag) + size(o.xs)
      if (i % 2000 == 0) { send(ch, o.tag) }
    }
    local
  }, w))
}
val totals = awaitAll(workers)
closeChannel(ch)
println(sum(totals), size(channelToArray(ch)))

// Single-threaded churn: closures capturing per-iteration frames, discarded at once.
def makeCounters(n) {
  val out = []
  for (i in range(n)) { push(out, () -> i * 2) }
  out
}
var acc = 0
for (round in range(200)) {
  val fns = makeCounters(50)
  for (f in fns) { acc += f() }
}
println(acc)

// Long-lived structures survive collections triggered by short-lived ones.
val keep = []
for (i in range(2000)) { push(keep, {"i": i, "s": "keep-" + i}) }
for (i in range(50000)) { val junk = "junk-" + i }
println(size(keep), keep[1999].s, keep[0].i)
