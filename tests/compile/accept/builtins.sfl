// The numeric builtins the compiler understands.
println(abs(-7), abs(7), abs(-2.5))
println(min(3, 9), max(3, 9), min(2.5, 1.5), max(2.5, 1.5))
println(sqrt(9.0), sqrt(2.0))
println(floor(3.7), ceil(3.2), floor(-3.7), ceil(-3.2))
println(round(2.5), round(-2.5), round(2.4), round(3.5))
println(trunc(-1.7), trunc(1.7), sign(-9), sign(0), sign(4), sign(-2.5))
println(pow(2, 10), pow(2.0, 0.5), pow(3, 0))
println(gcd(12, 18), gcd(-12, 18))
println(toInt(3.9), toInt(-3.9), toFloat(3))
println(round(log(2.718281828459045) * 1000.0))
println(round(exp(1.0) * 1000.0))
println(round(sin(0.0)), round(cos(0.0)))
