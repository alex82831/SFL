// Comparisons and short-circuit logic.
println(1 < 2, 2 <= 2, 3 > 4, 4 >= 4, 5 == 5, 5 != 5)
println(1.5 < 2, 2 == 2.0, 3.0 >= 3)
println(true && false, true || false, !true, !false)
var calls = 0
def bump() { calls = calls + 1; true }
// The right side must not run when the left already decides the answer.
val a = false && bump()
val b = true || bump()
println(a, b, calls)
val c = true && bump()
println(c, calls)
