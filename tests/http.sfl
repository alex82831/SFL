// The HTTP client (stdlib/http.sfl) against servers this file runs itself: every
// test drives both ends, so nothing depends on the network or on a clock race.
// The TLS block at the end needs the `openssl` command and is skipped without it.

import "lib/assert"

// The suite owns the proxy environment: real machines carry HTTP(S)_PROXY and
// NO_PROXY, and every request here must stay local and explicit. Empty means
// unset to the client (and to curl, whose rules it follows).
for (v in ["http_proxy", "HTTP_PROXY", "https_proxy", "HTTPS_PROXY",
           "all_proxy", "ALL_PROXY", "no_proxy", "NO_PROXY"]) {
  setEnv(v, "")
}

// ---------------------------------------------------------------- a tiny server

// One full request off a connection: [requestLine, headersByLowerName, body].
def readRequest(c) {
  val reqLine = socketReadLine(c)
  val hdrs = {}
  while (true) {
    val line = socketReadLine(c)
    if (line == null || line == "") { break }
    val ci = indexOf(line, ":")
    if (ci > 0) {
      hdrs[toLower(trim(substring(line, 0, ci)))] = trim(substring(line, ci + 1))
    }
  }
  var body = ""
  val cl = get(hdrs, "content-length", null)
  if (cl != null && parseInt(cl) > 0) {
    val b = bufNew()
    var left = parseInt(cl)
    while (left > 0) {
      val got = socketReadToBuf(c, b, left)
      if (got == null || got == 0) { break }
      left = left - got
    }
    body = bufString(b)
  }
  [reqLine, hdrs, body]
}

def sendResponse(c, status, headers, body) {
  socketWrite(c, "HTTP/1.1 ${status}\r\n")
  for (h in headers) { socketWrite(c, "${h}\r\n") }
  socketWrite(c, "\r\n")
  if (body != "") { socketWrite(c, body) }
}

// Serves exactly one connection; the spawned thread's result is what it saw,
// so the main thread asserts on it after await — no cross-thread counters. The
// accept has a deadline so a failing client cannot leave the suite hanging.
def serve1(respond) {
  val srv = serverSocket(0)
  val port = serverPort(srv)
  val t = spawn(() -> {
    val c = accept(srv, 10000)
    if (c == null) {
      closeServer(srv)
      null
    } else {
      val req = readRequest(c)
      val r = respond(req)
      sendResponse(c, r[0], r[1], r[2])
      closeSocket(c)
      closeServer(srv)
      req
    }
  })
  [port, t]
}

// accept with the same no-hang deadline, for the hand-driven servers below.
def accept1(srv) {
  val c = accept(srv, 10000)
  if (c == null) { error("test server: nobody connected") }
  c
}

// ------------------------------------------------------------------ plain requests

// The request on the wire: method, path, and the headers the contract promises.
val [p1, t1] = serve1(req -> ["200 OK", ["Content-Length: 5"], "hello"])
check("httpGet returns the body", httpGet("http://127.0.0.1:${p1}/hello?q=1"), "hello")
val seen1 = await(t1)
check("the request line carries the path and query", seen1[0], "GET /hello?q=1 HTTP/1.1")
check("Host names the origin", get(seen1[1], "host", null), "127.0.0.1:${p1}")
check("every request says Connection: close", get(seen1[1], "connection", null), "close")
check("Accept is curl's */*", get(seen1[1], "accept", null), "*/*")
check("a GET carries no Content-Length", has(seen1[1], "content-length"), false)

// Caller headers replace computed ones case-insensitively and add new ones.
val [p2, t2] = serve1(req -> ["200 OK", ["Content-Length: 2"], "ok"])
httpGet("http://127.0.0.1:${p2}/", {"HOST": "override.example", "X-Token": "t-1"})
val seen2 = await(t2)
check("a caller Host wins over the computed one", get(seen2[1], "host", null), "override.example")
check("caller headers are sent", get(seen2[1], "x-token", null), "t-1")

// httpPost: default content type, byte-counted Content-Length, body delivered.
val [p3, t3] = serve1(req -> ["200 OK", ["Content-Length: ${utf8Length(req[2])}"], req[2]])
check("httpPost echoes through", httpPost("http://127.0.0.1:${p3}/", "你好, post"), "你好, post")
val seen3 = await(t3)
check("the default content type is curl-era text/plain",
      get(seen3[1], "content-type", null), "text/plain; charset=utf-8")
check("Content-Length counts bytes, not code points",
      get(seen3[1], "content-length", null), "${utf8Length("你好, post")}")

val [p4, t4] = serve1(req -> ["200 OK", ["Content-Length: 0"], ""])
httpPost("http://127.0.0.1:${p4}/", "{}", "application/json")
check("an explicit content type is sent", get(await(t4)[1], "content-type", null), "application/json")

// httpRequest hands back {status, body} and never raises on a failing status.
val [p5, t5] = serve1(req -> ["404 Not Found", ["Content-Length: 4"], "gone"])
check("httpRequest reports status and body",
      httpRequest("delete", "http://127.0.0.1:${p5}/x"), {"status": 404, "body": "gone"})
check("the method arrives uppercased", startsWith(await(t5)[0], "DELETE /x "), true)

// HEAD and 204 have no body to read, Content-Length notwithstanding.
val [p6, t6] = serve1(req -> ["200 OK", ["Content-Length: 5"], ""])
check("HEAD reads no body", httpRequest("HEAD", "http://127.0.0.1:${p6}/"), {"status": 200, "body": ""})
await(t6)
val [p7, t7] = serve1(req -> ["204 No Content", [], ""])
check("204 has no body", httpRequest("GET", "http://127.0.0.1:${p7}/"), {"status": 204, "body": ""})
await(t7)

// ---------------------------------------------------------------------- framings

// Chunked, with a size extension and a trailer; CJK content keeps the
// single-decode path honest across chunk boundaries.
val chunkSrv = serverSocket(0)
val chunkPort = serverPort(chunkSrv)
val chunkT = spawn(() -> {
  val c = accept1(chunkSrv)
  readRequest(c)
  socketWrite(c, "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n")
  socketWrite(c, "8;note=1\r\nchunked-\r\n")
  socketWrite(c, "6\r\n中文\r\n")
  socketWrite(c, "3\r\n-ok\r\n")
  socketWrite(c, "0\r\nX-Trailer: t\r\n\r\n")
  closeSocket(c)
  closeServer(chunkSrv)
  true
})
check("chunked bodies reassemble", httpGet("http://127.0.0.1:${chunkPort}/"), "chunked-中文-ok")
await(chunkT)

// No framing at all: the body is everything until the peer closes.
val eofSrv = serverSocket(0)
val eofPort = serverPort(eofSrv)
val eofT = spawn(() -> {
  val c = accept1(eofSrv)
  readRequest(c)
  socketWrite(c, "HTTP/1.1 200 OK\r\n\r\nuntil-close")
  closeSocket(c)
  closeServer(eofSrv)
  true
})
check("an unframed body runs to end of stream", httpGet("http://127.0.0.1:${eofPort}/"), "until-close")
await(eofT)

// A 100 Continue interim response is read past, like curl reads past it.
val contSrv = serverSocket(0)
val contPort = serverPort(contSrv)
val contT = spawn(() -> {
  val c = accept1(contSrv)
  readRequest(c)
  socketWrite(c, "HTTP/1.1 100 Continue\r\n\r\n")
  socketWrite(c, "HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\nreal")
  closeSocket(c)
  closeServer(contSrv)
  true
})
check("interim 1xx responses are skipped", httpGet("http://127.0.0.1:${contPort}/"), "real")
await(contT)

// --------------------------------------------------------------------- redirects

// A POST through 302 becomes a GET without body; credentials in the URL become
// Basic auth and are dropped when the redirect changes origin (here: the port).
val hop2Srv = serverSocket(0)
val hop2Port = serverPort(hop2Srv)
val hop2T = spawn(() -> {
  val c = accept1(hop2Srv)
  val req = readRequest(c)
  sendResponse(c, "200 OK", ["Content-Length: 7"], "arrived")
  closeSocket(c)
  closeServer(hop2Srv)
  req
})
val hop1Srv = serverSocket(0)
val hop1Port = serverPort(hop1Srv)
val hop1T = spawn(() -> {
  val c = accept1(hop1Srv)
  val req = readRequest(c)
  sendResponse(c, "302 Found", ["Location: http://127.0.0.1:${hop2Port}/land"], "")
  closeSocket(c)
  closeServer(hop1Srv)
  req
})
check("a redirect chain lands", httpPost("http://user:pass@127.0.0.1:${hop1Port}/start", "data"), "arrived")
val hop1Seen = await(hop1T)
val hop2Seen = await(hop2T)
check("the first hop was the POST", startsWith(hop1Seen[0], "POST /start "), true)
check("URL credentials become Basic auth", get(hop1Seen[1], "authorization", null),
      "Basic ${base64Encode("user:pass")}")
check("302 turns the POST into a GET", startsWith(hop2Seen[0], "GET /land "), true)
check("the rewritten GET carries no body", has(hop2Seen[1], "content-length"), false)
check("credentials do not cross origins", has(hop2Seen[1], "authorization"), false)

// A relative Location resolves against the directory of the current path.
val relSrv = serverSocket(0)
val relPort = serverPort(relSrv)
val relT = spawn(() -> {
  val c = accept1(relSrv)
  readRequest(c)
  sendResponse(c, "302 Found", ["Location: next"], "")
  closeSocket(c)
  val c2 = accept1(relSrv)
  val req2 = readRequest(c2)
  sendResponse(c2, "200 OK", ["Content-Length: 3"], "rel")
  closeSocket(c2)
  closeServer(relSrv)
  req2
})
check("a relative Location resolves", httpGet("http://127.0.0.1:${relPort}/dir/page"), "rel")
check("against the path's directory", startsWith(await(relT)[0], "GET /dir/next "), true)

// The 33rd redirect is one too many; the server counts what it served.
val loopSrv = serverSocket(0)
val loopPort = serverPort(loopSrv)
val loopT = spawn(() -> {
  var served = 0
  while (true) {
    val c = accept(loopSrv, 2000)
    if (c == null) { break }
    readRequest(c)
    sendResponse(c, "302 Found", ["Location: /again"], "")
    closeSocket(c)
    served += 1
  }
  closeServer(loopSrv)
  served
})
checkFails("an endless redirect is cut off",
  () -> httpGet("http://127.0.0.1:${loopPort}/"), "maximum (32) redirects followed")
check("after exactly 33 requests", await(loopT), 33)

// ----------------------------------------------------------------------- proxies

// An explicit proxy sees the absolute-URI form and the target Host; the origin
// here never resolves, so only the proxy can have answered.
val proxSrv = serverSocket(0)
val proxPort = serverPort(proxSrv)
val proxT = spawn(() -> {
  val c = accept1(proxSrv)
  val req = readRequest(c)
  sendResponse(c, "200 OK", ["Content-Length: 9"], "via-proxy")
  closeSocket(c)
  closeServer(proxSrv)
  req
})
check("httpGetProxy goes through the proxy",
      httpGetProxy("http://origin.invalid/thing", "127.0.0.1:${proxPort}"), "via-proxy")
val proxSeen = await(proxT)
check("a proxied request is absolute-form", proxSeen[0], "GET http://origin.invalid:80/thing HTTP/1.1")
check("Host still names the origin", get(proxSeen[1], "host", null), "origin.invalid")

// Proxy credentials ride Proxy-Authorization; the environment variables steer
// requests the same way, and no_proxy exempts a host from them. The origin is a
// real local server, so the exemption is proven by who answers.
val originSrv = serverSocket(0)
val originPort = serverPort(originSrv)
val originT = spawn(() -> {
  val c = accept1(originSrv)
  readRequest(c)
  sendResponse(c, "200 OK", ["Content-Length: 6"], "direct")
  closeSocket(c)
  closeServer(originSrv)
  true
})
val prox2Srv = serverSocket(0)
val prox2Port = serverPort(prox2Srv)
val prox2T = spawn(() -> {
  val c = accept1(prox2Srv)
  val req = readRequest(c)
  sendResponse(c, "200 OK", ["Content-Length: 4"], "env!")
  closeSocket(c)
  closeServer(prox2Srv)
  req
})
setEnv("http_proxy", "http://pu:pw@127.0.0.1:${prox2Port}")
check("http_proxy is honoured", httpGet("http://127.0.0.1:${originPort}/"), "env!")
check("with Proxy-Authorization from the proxy URL",
      get(await(prox2T)[1], "proxy-authorization", null), "Basic ${base64Encode("pu:pw")}")
setEnv("no_proxy", "127.0.0.1")
check("no_proxy exempts the host, and the origin answers directly",
      httpGet("http://127.0.0.1:${originPort}/"), "direct")
await(originT)
setEnv("http_proxy", "")
setEnv("no_proxy", "")

// ------------------------------------------------- the proxy argument everywhere

// Every request function takes a trailing proxy; a bare host:port is an http
// proxy, so the request arrives in absolute form.
val [pa, ta] = serve1(req -> ["200 OK", ["Content-Length: 3"], "get"])
check("httpGet takes a proxy argument",
      httpGet("http://origin.invalid/a", null, "127.0.0.1:${pa}"), "get")
check("in absolute form", await(ta)[0], "GET http://origin.invalid:80/a HTTP/1.1")

// Proxy URL credentials are percent-decoded before they become Basic; a null
// contentType keeps the default, so the proxy argument is reachable positionally.
val [pb, tb] = serve1(req -> ["200 OK", ["Content-Length: 4"], "post"])
check("httpPost takes a proxy argument, past a null content type",
      httpPost("http://origin.invalid/b", "x", null, null,
               "http://u%40x:p%3Aw@127.0.0.1:${pb}"), "post")
val pbSeen = await(tb)
check("proxy URL credentials are percent-decoded",
      get(pbSeen[1], "proxy-authorization", null), "Basic ${base64Encode("u@x:p:w")}")
check("and the default content type still rode along",
      get(pbSeen[1], "content-type", null), "text/plain; charset=utf-8")

// The object spelling carries credentials with no percent-encoding to get right.
val [pc, tc] = serve1(req -> ["200 OK", ["Content-Length: 3"], "obj"])
check("a proxy can be an object",
      httpRequest("GET", "http://origin.invalid/c", null, null, null,
                  {"host": "127.0.0.1", "port": pc, "username": "po", "password": "p@w"}),
      {"status": 200, "body": "obj"})
check("whose credentials become Proxy-Authorization as written",
      get(await(tc)[1], "proxy-authorization", null), "Basic ${base64Encode("po:p@w")}")

val [pd, td] = serve1(req -> ["200 OK", ["Content-Length: 3"], "gpo"])
check("httpGetProxy accepts the object spelling too",
      httpGetProxy("http://origin.invalid/d", {"host": "127.0.0.1", "port": pd}), "gpo")
await(td)

// The empty string is curl's -x '': a direct connection past the environment.
val [pe, te] = serve1(req -> ["200 OK", ["Content-Length: 6"], "direct"])
setEnv("http_proxy", "127.0.0.1:1")
check("an empty proxy forces a direct connection",
      httpGet("http://127.0.0.1:${pe}/", null, ""), "direct")
setEnv("http_proxy", "")
await(te)

// URL credentials on the target decode the same way.
val [pf, tf] = serve1(req -> ["200 OK", ["Content-Length: 2"], "cr"])
httpGet("http://we%40b:s%3Acret@127.0.0.1:${pf}/")
check("target URL credentials are percent-decoded for Basic auth",
      get(await(tf)[1], "authorization", null), "Basic ${base64Encode("we@b:s:cret")}")

// ------------------------------------------------------------------------- SOCKS

// Exactly n bytes off a test connection, or a test failure.
def readB(c, n) {
  val out = []
  while (length(out) < n) {
    val got = socketReadBytes(c, n - length(out), 10000)
    if (got == null || length(got) == 0) { error("test server: short SOCKS read") }
    for (b in got) { push(out, b) }
  }
  out
}

// A one-connection SOCKS5 server. auth is [user, pass] to demand RFC 1929
// authentication or null for none; the handshake it saw comes back through the
// thread, and a granted tunnel serves one HTTP exchange via respond.
def socks5Server(auth, respond) {
  val srv = serverSocket(0)
  val port = serverPort(srv)
  val t = spawn(() -> {
    val c = accept1(srv)
    val seen = {}
    val hello = readB(c, 2)
    seen["methods"] = readB(c, hello[1])
    var granted = true
    if (auth != null) {
      socketWriteBytes(c, [5, 2])
      readB(c, 1) // the sub-negotiation version
      seen["user"] = utf8Decode(readB(c, readB(c, 1)[0]))
      seen["pass"] = utf8Decode(readB(c, readB(c, 1)[0]))
      if (seen.user == auth[0] && seen.pass == auth[1]) {
        socketWriteBytes(c, [1, 0])
      } else {
        socketWriteBytes(c, [1, 1])
        granted = false
      }
    } else {
      socketWriteBytes(c, [5, 0])
    }
    if (granted) {
      val req = readB(c, 4)
      seen["atyp"] = req[3]
      if (req[3] == 1) {
        val ip = readB(c, 4)
        seen["addr"] = "${ip[0]}.${ip[1]}.${ip[2]}.${ip[3]}"
      } else if (req[3] == 3) {
        seen["addr"] = utf8Decode(readB(c, readB(c, 1)[0]))
      } else {
        seen["addr"] = readB(c, 16)
      }
      val pb = readB(c, 2)
      seen["port"] = pb[0] * 256 + pb[1]
      socketWriteBytes(c, [5, 0, 0, 1, 0, 0, 0, 0, 0, 0])
      val httpReq = readRequest(c)
      seen["req"] = httpReq
      val r = respond(httpReq)
      sendResponse(c, r[0], r[1], r[2])
    }
    closeSocket(c)
    closeServer(srv)
    seen
  })
  [port, t]
}

// A one-connection SOCKS4/4a server, same shape.
def socks4Server(respond) {
  val srv = serverSocket(0)
  val port = serverPort(srv)
  val t = spawn(() -> {
    val c = accept1(srv)
    val seen = {}
    val head = readB(c, 8)
    seen["command"] = head[1]
    seen["port"] = head[2] * 256 + head[3]
    seen["ip"] = [head[4], head[5], head[6], head[7]]
    var user = []
    while (true) {
      val b = readB(c, 1)[0]
      if (b == 0) { break }
      push(user, b)
    }
    seen["user"] = utf8Decode(user)
    seen["domain"] = null
    if (head[4] == 0 && head[5] == 0 && head[6] == 0 && head[7] != 0) {
      var db = []
      while (true) {
        val b = readB(c, 1)[0]
        if (b == 0) { break }
        push(db, b)
      }
      seen["domain"] = utf8Decode(db)
    }
    socketWriteBytes(c, [0, 90, 0, 0, 0, 0, 0, 0])
    val httpReq = readRequest(c)
    seen["req"] = httpReq
    val r = respond(httpReq)
    sendResponse(c, r[0], r[1], r[2])
    closeSocket(c)
    closeServer(srv)
    seen
  })
  [port, t]
}

// SOCKS5 without authentication: the host name goes through unresolved.
val [sp1, st1] = socks5Server(null, req -> ["200 OK", ["Content-Length: 9"], "via-socks"])
check("httpGet tunnels through SOCKS5",
      httpGet("http://origin.invalid:8081/s", null, "socks5://127.0.0.1:${sp1}"), "via-socks")
val s1 = await(st1)
check("without credentials only no-auth is offered", s1.methods, [0])
check("the host name reaches the proxy unresolved", s1.addr, "origin.invalid")
check("with the target port", s1.port, 8081)
check("the tunneled request is origin-form", s1.req[0], "GET /s HTTP/1.1")
check("and Host names the origin", get(s1.req[1], "host", null), "origin.invalid:8081")

// SOCKS5 with RFC 1929 username/password, spelled as a proxy object.
val [sp2, st2] = socks5Server(["alice", "s3cr3t"],
                              req -> ["200 OK", ["Content-Length: 2"], "ok"])
check("httpRequest tunnels through SOCKS5 with credentials",
      httpRequest("GET", "http://origin.invalid/o", null, null, null,
                  {"protocol": "socks5", "host": "127.0.0.1", "port": sp2,
                   "username": "alice", "password": "s3cr3t"}),
      {"status": 200, "body": "ok"})
val s2 = await(st2)
check("credentials offer no-auth and username/password", s2.methods, [0, 2])
check("the username arrived", s2.user, "alice")
check("the password arrived", s2.pass, "s3cr3t")

// A wrong password is refused by the sub-negotiation, and says so.
val [sp3, st3] = socks5Server(["alice", "right"],
                              req -> ["200 OK", ["Content-Length: 1"], "x"])
checkFails("a rejected SOCKS5 password surfaces",
  () -> httpGet("http://origin.invalid/x", null, "socks5://alice:wrong@127.0.0.1:${sp3}"),
  "the SOCKS5 proxy rejected the username or password")
await(st3)

// An IPv4 literal travels in its native address type, and socks5h works alike.
val [sp4, st4] = socks5Server(null, req -> ["200 OK", ["Content-Length: 2"], "ip"])
check("an IPv4 literal target",
      httpGet("http://127.0.0.9:9/ip", null, "socks5h://127.0.0.1:${sp4}"), "ip")
val s4 = await(st4)
check("travels as ATYP 1", s4.atyp, 1)
check("with its four bytes", s4.addr, "127.0.0.9")

// An IPv6 literal travels as ATYP 4 — sixteen bytes, '::' compression and an
// embedded dotted quad included.
val [sp6, st6] = socks5Server(null, req -> ["200 OK", ["Content-Length: 2"], "v6"])
check("an IPv6 literal target",
      httpGet("http://[2001:db8::ff:1.2.3.4]:8085/v6", null, "socks5://127.0.0.1:${sp6}"), "v6")
val s6 = await(st6)
check("travels as ATYP 4", s6.atyp, 4)
check("as its sixteen bytes", s6.addr,
      [32, 1, 13, 184, 0, 0, 0, 0, 0, 0, 0, 255, 1, 2, 3, 4])
check("with the target port", s6.port, 8085)

// The environment can name a SOCKS proxy, as it can for curl.
val [sp5, st5] = socks5Server(["eve", "pw"], req -> ["200 OK", ["Content-Length: 3"], "env"])
setEnv("all_proxy", "socks5://eve:pw@127.0.0.1:${sp5}")
check("all_proxy may be a SOCKS URL", httpGet("http://origin.invalid/e"), "env")
setEnv("all_proxy", "")
check("whose credentials went through", await(st5).user, "eve")

// SOCKS4a: the domain rides behind the 0.0.0.x marker, the username in the
// identd field; a socks4 IPv4 literal goes in the classic form.
val [fp1, ft1] = socks4Server(req -> ["200 OK", ["Content-Length: 3"], "s4a"])
check("httpGet tunnels through SOCKS4a",
      httpGet("http://origin.invalid:8082/f", null, "socks4a://u4@127.0.0.1:${fp1}"), "s4a")
val f1 = await(ft1)
check("the marker address signals a domain", f1.ip, [0, 0, 0, 1])
check("the domain follows the user field", f1.domain, "origin.invalid")
check("the identd field carries the username", f1.user, "u4")
check("the port is the target's", f1.port, 8082)

val [fp2, ft2] = socks4Server(req -> ["200 OK", ["Content-Length: 2"], "s4"])
check("socks4 sends an IPv4 literal directly",
      httpGet("http://127.0.0.9:8083/g", null, "socks4://127.0.0.1:${fp2}"), "s4")
val f2 = await(ft2)
check("as the four address bytes", f2.ip, [127, 0, 0, 9])
check("with no trailing domain", f2.domain, null)

// ------------------------------------------------------------------ proxy errors

checkFails("an unknown proxy protocol is refused",
  () -> httpGet("http://x/", null, "ftp://127.0.0.1:1"), "unsupported proxy protocol 'ftp'")
checkFails("the proxy argument type is checked",
  () -> httpGet("http://x/", null, 5), "httpGet: argument 3 must be a string or an object")
checkFails("a proxy object needs a host",
  () -> httpGet("http://x/", null, {"port": 1080}), "a proxy object needs a non-empty string 'host'")
checkFails("a proxy password without a username is caught",
  () -> httpGet("http://x/", null, {"host": "h", "password": "p"}),
  "a proxy 'password' needs a 'username' beside it")
checkFails("an https URL cannot ride an https proxy",
  () -> httpGet("https://x/", null, "https://127.0.0.1:1"),
  "TLS inside TLS is not supported")
// The IPv6-versus-SOCKS4 clash is caught client-side, after the dial: the
// server socket here only ever completes the TCP handshake.
val s4bad = serverSocket(0)
checkFails("SOCKS4 cannot reach an IPv6 literal",
  () -> httpGet("http://[::1]:9/", null, "socks4://127.0.0.1:${serverPort(s4bad)}"),
  "a SOCKS4 proxy cannot reach an IPv6 address")
closeServer(s4bad)

// ------------------------------------------------------------------------ errors

checkFails("a URL needs a scheme", () -> httpGet("nope"), "unsupported URL")
checkFails("only http and https are spoken", () -> httpGet("ftp://x/"), "unsupported protocol 'ftp'")
checkFails("httpGet checks the URL type", () -> httpGet(42), "httpGet: argument 1 must be a string")
checkFails("httpGet checks the headers type", () -> httpGet("http://127.0.0.1/", 5),
  "httpGet: argument 2 must be an object")
checkFails("httpRequest checks the method type", () -> httpRequest(1, "http://x/"),
  "httpRequest: argument 1 must be a string")
val deadSrv = serverSocket(0)
val deadPort = serverPort(deadSrv)
closeServer(deadSrv)
checkFails("a refused connection is a transport failure",
  () -> httpGet("http://127.0.0.1:${deadPort}/"), "HTTP request failed:")

// --------------------------------------------------------------------------- TLS

// Needs the openssl command for a certificate and an https server; skipped
// without it. SSL_CERT_FILE is set before the first tlsWrap anywhere, because
// the shared verifying context reads the trust store exactly once.
val hasOpenssl = execute("which openssl").code == 0
if (!hasOpenssl) {
  println("skip: the TLS tests need the openssl command")
} else {
  val key = tempFile(".key")
  val cert = tempFile(".pem")
  val gen = execute("openssl req -x509 -newkey rsa:2048 -keyout '${key}' -out '${cert}'" +
    " -days 2 -nodes -subj '/CN=localhost'" +
    " -addext 'subjectAltName=DNS:localhost,IP:127.0.0.1' 2>/dev/null")
  if (gen.code != 0) {
    println("skip: could not generate a test certificate")
  } else {
    setEnv("SSL_CERT_FILE", cert)
    val portProbe = serverSocket(0)
    val tlsPort = serverPort(portProbe)
    closeServer(portProbe)
    val server = processStart("openssl s_server -accept ${tlsPort} -key '${key}' -cert '${cert}' -www -quiet")
    var ready = false
    for (i in range(100)) {
      if (!ready) {
        val probe = try(() -> connect("127.0.0.1", tlsPort, 200), e -> null)
        if (probe != null) {
          closeSocket(probe)
          ready = true
        } else {
          sleep(50)
        }
      }
    }
    checkTrue("the TLS test server came up", ready)
    if (ready) {
      // The whole client stack over TLS: s_server's -www page is unframed (HTTP/1.0,
      // no Content-Length), so this also exercises the read-to-close path.
      val page = httpGet("https://localhost:${tlsPort}/")
      checkTrue("httpGet speaks https", contains(page, "s_server"))

      // tlsWrap by hand, trusting the test certificate explicitly.
      val c = connect("localhost", tlsPort, 5000)
      tlsWrap(c, "localhost", cert, 5000)
      socketWrite(c, "GET / HTTP/1.0\r\n\r\n")
      checkTrue("a wrapped socket reads the status line",
        contains(socketReadLine(c, 5000), "200"))
      closeSocket(c)

      // Verification is real: a trust store without this server rejects it.
      val otherKey = tempFile(".key")
      val otherCert = tempFile(".pem")
      execute("openssl req -x509 -newkey rsa:2048 -keyout '${otherKey}' -out '${otherCert}'" +
        " -days 2 -nodes -subj '/CN=other' 2>/dev/null")
      val c2 = connect("localhost", tlsPort, 5000)
      checkFails("the wrong trust store is refused",
        () -> tlsWrap(c2, "localhost", otherCert, 5000), "certificate verify failed")
      closeSocket(c2)
      removeFile(otherKey)
      removeFile(otherCert)

      processKill(server, true)
      processWait(server)
    }

    // ------------------------------------------------- proxies meeting TLS

    // An https target through an http proxy: the CONNECT tunnel carries the
    // proxy credentials, and the request proper runs over TLS inside it. The
    // proxy here grants the tunnel and then is the TLS server itself, so the
    // named target never needs to exist.
    val cpSrv = serverSocket(0)
    val cpPort = serverPort(cpSrv)
    val cpT = spawn(() -> {
      val c = accept1(cpSrv)
      val connectReq = readRequest(c)
      socketWrite(c, "HTTP/1.1 200 Connection established\r\n\r\n")
      tlsAccept(c, cert, key, null, 10000)
      val req = readRequest(c)
      sendResponse(c, "200 OK", ["Content-Length: 8"], "tunneled")
      closeSocket(c)
      closeServer(cpSrv)
      [connectReq, req]
    })
    check("an https URL rides CONNECT through an http proxy",
          httpGet("https://localhost:4443/secret", null, "http://cu:cp@127.0.0.1:${cpPort}"),
          "tunneled")
    val cpSeen = await(cpT)
    check("the CONNECT names host:port", cpSeen[0][0], "CONNECT localhost:4443 HTTP/1.1")
    check("and carries the proxy credentials",
          get(cpSeen[0][1], "proxy-authorization", null), "Basic ${base64Encode("cu:cp")}")
    check("the tunneled request is origin-form", cpSeen[1][0], "GET /secret HTTP/1.1")

    // An https target through SOCKS5: TLS starts inside the granted tunnel.
    val stSrv = serverSocket(0)
    val stPort = serverPort(stSrv)
    val stT = spawn(() -> {
      val c = accept1(stSrv)
      val hello = readB(c, 2)
      readB(c, hello[1])
      socketWriteBytes(c, [5, 0])
      val req = readB(c, 4)
      var dlen = 0
      if (req[3] == 3) { dlen = readB(c, 1)[0] }
      val dom = utf8Decode(readB(c, dlen))
      readB(c, 2)
      socketWriteBytes(c, [5, 0, 0, 1, 0, 0, 0, 0, 0, 0])
      tlsAccept(c, cert, key, null, 10000)
      val httpReq = readRequest(c)
      sendResponse(c, "200 OK", ["Content-Length: 9"], "socks-tls")
      closeSocket(c)
      closeServer(stSrv)
      [dom, httpReq]
    })
    check("an https URL tunnels through SOCKS5",
          httpGet("https://localhost:4444/s", null, "socks5://127.0.0.1:${stPort}"),
          "socks-tls")
    val stSeen = await(stT)
    check("the tunnel was asked for the TLS host", stSeen[0], "localhost")

    // An https proxy: TLS to the proxy itself, then the absolute-form request
    // for an http target inside that one TLS layer.
    val hpSrv = serverSocket(0)
    val hpPort = serverPort(hpSrv)
    val hpT = spawn(() -> {
      val c = accept1(hpSrv)
      tlsAccept(c, cert, key, null, 10000)
      val req = readRequest(c)
      sendResponse(c, "200 OK", ["Content-Length: 9"], "via-https")
      closeSocket(c)
      closeServer(hpSrv)
      req
    })
    check("an http URL goes through an https proxy",
          httpGet("http://origin.invalid/h", null, "https://ju:jp@localhost:${hpPort}"),
          "via-https")
    val hpSeen = await(hpT)
    check("as an absolute-form request over the proxy's TLS",
          hpSeen[0], "GET http://origin.invalid:80/h HTTP/1.1")
    check("with the proxy credentials",
          get(hpSeen[1], "proxy-authorization", null), "Basic ${base64Encode("ju:jp")}")

    removeFile(key)
    removeFile(cert)
  }
}

report("http")
