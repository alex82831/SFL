import "lib/assert"

// Establish the counter the module inspects before importing it.
globalCounters = {}
geometryLoads = 0

import "lib/geometry"

check("imported constant", round(TAU, 4), 6.2832)
check("imported function", round(circleArea(2.0), 2), 12.57)
check("module ran once", geometryLoads, 1)

// Importing the same module again must be a no-op rather than re-running it.
import "lib/geometry"
check("second import is a no-op", geometryLoads, 1)

// Imports are resolved relative to the importing file, so this works from any cwd.
check("assert module is loaded", isFunction(check), true)

report("imports")
