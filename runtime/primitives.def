SFL_PRIM("atomicCompareSet", sfl_p_atomicCompareSet, "atomicCompareSet(a, expected, v)", 3, 3, thread)
SFL_PRIM("atomicGet", sfl_p_atomicGet, "atomicGet(a)", 1, 1, thread)
SFL_PRIM("atomicSet", sfl_p_atomicSet, "atomicSet(a, v)", 2, 2, thread)
SFL_PRIM("atomicUpdate", sfl_p_atomicUpdate, "atomicUpdate(a, f)", 2, 2, thread)
SFL_PRIM("awaitLatch", sfl_p_awaitLatch, "awaitLatch(l, timeoutMs?)", 1, 2, thread)
SFL_PRIM("countDown", sfl_p_countDown, "countDown(l)", 1, 1, thread)
SFL_PRIM("latch", sfl_p_latch, "latch(n)", 1, 1, thread)
SFL_PRIM("latchCount", sfl_p_latchCount, "latchCount(l)", 1, 1, thread)
SFL_PRIM("lock", sfl_p_lock, "lock(m)", 1, 1, thread)
SFL_PRIM("mutex", sfl_p_mutex, "mutex()", 0, 0, thread)
SFL_PRIM("release", sfl_p_release, "release(s)", 1, 1, thread)
SFL_PRIM("semaphore", sfl_p_semaphore, "semaphore(permits)", 1, 1, thread)
SFL_PRIM("tryLock", sfl_p_tryLock, "tryLock(m, timeoutMs?)", 1, 2, thread)
SFL_PRIM("unlock", sfl_p_unlock, "unlock(m)", 1, 1, thread)
SFL_PRIM("withLock", sfl_p_withLock, "withLock(m, f)", 2, 2, thread)
SFL_PRIM("await", sfl_p_await, "await(t, timeoutMs?)", 1, 2, thread)
SFL_PRIM("awaitAll", sfl_p_awaitAll, "awaitAll(threads, timeoutMs?)", 1, 2, thread)
SFL_PRIM("awaitAny", sfl_p_awaitAny, "awaitAny(threads, timeoutMs?)", 1, 2, thread)
SFL_PRIM("cpuCount", sfl_p_cpuCount, "cpuCount()", 0, 0, thread)
SFL_PRIM("currentThreadName", sfl_p_currentThreadName, "currentThreadName()", 0, 0, thread)
SFL_PRIM("isAlive", sfl_p_isAlive, "isAlive(t)", 1, 1, thread)
SFL_PRIM("parallelMap", sfl_p_parallelMap, "parallelMap(arr, f, workers?)", 2, 3, thread)
SFL_PRIM("spawn", sfl_p_spawn, "spawn(f, ...args)", 1, -1, thread)
SFL_PRIM("spawnDaemon", sfl_p_spawnDaemon, "spawnDaemon(f, ...args)", 1, -1, thread)
SFL_PRIM("threadFailed", sfl_p_threadFailed, "threadFailed(t)", 1, 1, thread)
SFL_PRIM("threadName", sfl_p_threadName, "threadName(t)", 1, 1, thread)
SFL_PRIM("yieldThread", sfl_p_yieldThread, "yieldThread()", 0, 0, thread)

/* ---- internal ---- */
/* Not a user-visible builtin: the standard library uses it to build a lazy
   iterator from a function, which is how map/filter stay lazy over iterators.
   The interpreter defines it too, so stdlib sources run either way. */
SFL_PRIM("__iterFn", sfl_p___iterFn, "__iterFn(next)", 1, 1, coll)
/* The declared parameter count of a function, which SFL has no syntax for and
   curry() needs when it is not told an arity. */
SFL_PRIM("__arity", sfl_p___arity, "__arity(f)", 1, 1, fast)
/* Raised by desugared patterns when a val/var destructuring does not match. */
SFL_PRIM("__patFail", sfl_p___patFail, "__patFail(expected, got)", 2, 2, fast)

