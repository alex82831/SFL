import "jwt"

def check(what, got, want) {
  if (got != want) {
    eprintln("FAIL ${what}: got ${got}, want ${want}")
    exit(1)
  }
}

val secret = "test-secret"
val t = jwt.sign({sub: "u1", exp: 2000000000}, secret)
check("round trip", jwt.verify(t, secret).sub, "u1")
check("decode without verify", jwt.decode(t).payload.sub, "u1")

val forged = attempt(() -> jwt.verify(t + "x", secret))
check("forgery fails", forged.error != null, true)
val wrongKey = attempt(() -> jwt.verify(t, "other"))
check("wrong secret fails", wrongKey.error != null, true)

val stale = jwt.sign({exp: 1000}, secret)
check("expiry fails at a later atSec", attempt(() -> jwt.verify(stale, secret, {atSec: 2000})).error != null, true)
check("leeway forgives", jwt.verify(stale, secret, {atSec: 1030, leewaySec: 60}).exp, 1000)

println("auth: ok")
