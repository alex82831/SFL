import "../src/store"
import "cli"

def check(what, got, want) {
  if (got != want) {
    eprintln("FAIL ${what}: got " + jsonStringify(got) + ", want " + jsonStringify(want))
    exit(1)
  }
}

// The store, against a scratch file.
val f = tempFile("todo-test")
removeFile(f)
check("empty store", storeLoad(f), [])
val a = storeAdd(f, "first")
val b = storeAdd(f, "second")
check("ids count up", [a.id, b.id], [1, 2])
check("load sees both", map(storeLoad(f), (t) -> t.text), ["first", "second"])
check("done marks", storeDone(f, 1).done, true)
check("done on a ghost", storeDone(f, 99), null)
check("clear removes finished", storeClearDone(f), 1)
check("remove", storeRemove(f, 2), true)
check("store is empty again", storeLoad(f), [])
removeFile(f)

// The argument grammar, through cliParseArgs — the pure, non-exiting parser.
val spec = {
  name: "todo", doc: "d",
  flags: {all: {short: "a", doc: "x"}},
  options: {file: {short: "f", doc: "x", default: "todo.json"}},
  positionals: [{name: "command"}, {name: "rest", variadic: true}]
}
val p1 = cliParseArgs(spec, ["add", "buy", "milk"])
check("positionals split", [p1.positionals.command, p1.positionals.rest], ["add", ["buy", "milk"]])
check("defaults fill", p1.options.file, "todo.json")
val p2 = cliParseArgs(spec, ["-a", "--file=other.json", "list"])
check("flags and options parse", [p2.flags.all, p2.options.file], [true, "other.json"])

println("todo: ok")
