def check(what, got, want) {
  if (got != want) {
    eprintln("FAIL ${what}: got " + jsonStringify(got) + ", want " + jsonStringify(want))
    exit(1)
  }
}

check("naturals take", naturals() |> take(4) |> toArray, [0, 1, 2, 3])
check("iterate", iterate((n) -> n * 3, 1) |> take(4) |> toArray, [1, 3, 9, 27])
check("cycle", cycle([1, 2]) |> take(5) |> toArray, [1, 2, 1, 2, 1])
check("lazy map+filter", naturals() |> map((n) -> n * n) |> filter((n) -> n % 2 == 1) |> take(3) |> toArray,
  [1, 9, 25])
check("takeWhile", iterate((n) -> n * 2, 1) |> takeWhile((n) -> n < 20) |> toArray,
  [1, 2, 4, 8, 16])

var ran = 0
val seq = naturals() |> map((n) -> {
  ran += 1
  n
})
seq |> take(2) |> toArray
check("evaluation is on demand", ran <= 3, true)

println("lazy: ok")
