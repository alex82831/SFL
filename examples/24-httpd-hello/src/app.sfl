// The application, as a function returning its route table — main starts a
// real server around it, the tests drive it on an ephemeral port.

import "httpd"

def app() {
  httpd.routes([
    httpd.GET("/", (req) -> httpd.redirect("/assets/index.html")),
    // :name captures one path segment into req.params.
    httpd.GET("/hello/:name", (req) -> {
      val times = parseInt(get(req.query, "times", "1"))
      httpd.respondText(200, repeat("hello, ${req.params.name}!\n", times))
    }),
    httpd.GET("/api/time", (req) -> httpd.respondJson(200, {
      epochMs: timeMillis(),
      utc: formatTime(timeMillis(), "%Y-%m-%dT%H:%M:%SZ", true)
    })),
    httpd.POST("/api/sum", (req) -> {
      val ns = jsonParse(req.body)
      httpd.respondJson(200, {sum: sum(ns), count: length(ns)})
    }),
    // *rest captures the remaining path — a tiny reflector.
    httpd.GET("/echo/*rest", (req) -> httpd.respondJson(200, {path: req.params.rest, query: req.query})),
    // Static files: content types, conditional requests and ranges included.
    httpd.STATIC("/assets", "public")
  ])
}
