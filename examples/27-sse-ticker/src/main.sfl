// A live ticker over server-sent events. Open the page and watch it move;
// curl sees the raw stream:
//
//   curl -N localhost:8080/events

import "httpd"
import "ticker"

val srv = httpd.server({port: 8080, handler: tickerApp(1000000, 1000)})
println("ticker on http://127.0.0.1:8080 — Ctrl-C stops it")
srv.listen()
