def check(what, got, want) {
  if (got != want) {
    eprintln("FAIL ${what}: got " + jsonStringify(got) + ", want " + jsonStringify(want))
    exit(1)
  }
}

val ns = [3, 1, 4, 1, 5, 9, 2, 6]
check("map", map(ns, (n) -> n * 2), [6, 2, 8, 2, 10, 18, 4, 12])
check("filter", filter(ns, (n) -> n % 2 == 0), [4, 2, 6])
check("reduce", reduce(ns, (a, b) -> a + b, 0), 31)
check("groupBy", groupBy(ns, (n) -> n % 2), {"1": [3, 1, 1, 5, 9], "0": [4, 2, 6]})
check("sortBy descending", sortBy(ns, (n) -> -n), [9, 6, 5, 4, 3, 2, 1, 1])
check("unique keeps first", unique([2, 1, 2, 3, 1]), [2, 1, 3])
check("flatMap", flatMap([1, 2], (n) -> [n, n]), [1, 1, 2, 2])
check("zip", zip([1, 2], ["a", "b"]), [[1, "a"], [2, "b"]])
check("assoc copies", {
  val o = {a: 1}
  val o2 = assoc(o, "a", 2)
  [o.a, o2.a]
}, [1, 2])
check("updateIn", updateIn({a: {b: 2}}, ["a", "b"], (n) -> n * 10), {a: {b: 20}})
val [h, ...t] = [1, 2, 3]
check("rest destructuring", [h, t], [1, [2, 3]])
println("collections: ok")
