import "../main"

def check(what, got, want) {
  if (got != want) {
    eprintln("FAIL ${what}: got " + jsonStringify(got) + ", want " + jsonStringify(want))
    exit(1)
  }
}

check("mean", mean([1, 2, 3, 4]), 2.5)
check("variance", variance([2, 4, 4, 4, 5, 5, 7, 9]), 4.0)
check("stddev", stddev([2, 4, 4, 4, 5, 5, 7, 9]), 2.0)
check("median odd", median([9, 1, 5]), 5)
check("median even", median([4, 1, 3, 2]), 2.5)
check("vecAdd", vecAdd([1, 2], [10, 20]), [11, 22])
check("vecDot", vecDot([1, 2, 3], [4, 5, 6]), 32)
check("vecNorm", vecNorm([3.0, 4.0]), 5.0)
check("clamp01", [clamp01(-2.0), clamp01(0.25), clamp01(9.0)], [0.0, 0.25, 1.0])

val fails = attempt(() -> mean([]))
check("empty input is refused", contains(fails.error.message, "empty"), true)

// Private names stay private: _requireSome is not visible here.
val hidden = attempt(() -> eval("_requireSome([1], \"x\")"))
check("underscore names are file-private", hidden.error != null, true)

println("mathkit: ok")
