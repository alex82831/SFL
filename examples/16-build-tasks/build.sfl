// This example is mostly ABOUT its build file. build.sfl is ordinary SFL:
// the build tool defines project() and task(), evaluates this file, and
// whatever tasks you registered join build/run/test/clean on the menu.

project({
  "name": "build-tasks",
  "version": "0.1.0",
  "main": "src/main.sfl"
})

// Code generation: bake a data file into a source module. `sfl build gen`
// refreshes src/generated.sfl; the incremental build then sees it changed.
task("gen", (args) -> {
  val words = readFile("data/words.txt") |> trim |> lines
  val src = "// Generated by `sfl build gen` from data/words.txt — do not edit.\n" +
    "val WORDS = " + jsonStringify(words) + "\n"
  writeFile("src/generated.sfl", src)
  println("generated src/generated.sfl with ${length(words)} words")
}, "Regenerate src/generated.sfl from data/words.txt")

// Lines-of-code, a read-only reporting task.
task("loc", (args) -> {
  var total = 0
  for (path in listFiles("src")) {
    if (endsWith(path, ".sfl")) {
      val n = length(lines(readFile(joinPath("src", path))))
      printf("%5d  %s\n", n, path)
      total += n
    }
  }
  printf("%5d  total\n", total)
}, "Count lines of SFL under src/")

// Chain the built-ins from a task: exePath() is this sfl binary,
// passthrough() streams the child's output as it happens.
task("check", (args) -> {
  var code = passthrough(exePath(), ["check", "src/main.sfl", "src/generated.sfl"])
  if (code != 0) { return code }
  passthrough(exePath(), ["build", "test"])
}, "Syntax-check the sources, then run the tests")

// Tasks receive their arguments: `sfl build shout hello there`.
task("shout", (args) -> {
  println(toUpper(join(args, " ")) + "!")
}, "Upper-case its arguments, loudly")
