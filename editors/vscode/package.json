{
  "name": "sfl-lang",
  "displayName": "SFL",
  "description": "SFL language support: highlighting, diagnostics, completion, navigation, debugging, and an SFL Projects view that builds and runs every build.sfl in the workspace.",
  "version": "0.3.0",
  "publisher": "fartech",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "sfl",
    "scripting"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "sfl",
        "aliases": [
          "SFL",
          "sfl"
        ],
        "extensions": [
          ".sfl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sfl",
        "scopeName": "source.sfl",
        "path": "./syntaxes/sfl.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "sfl.newProject",
        "title": "SFL: New Project…",
        "shortTitle": "SFL Project"
      },
      {
        "command": "sfl.runFile",
        "title": "SFL: Run File",
        "icon": "$(play)"
      },
      {
        "command": "sfl.debugFile",
        "title": "SFL: Debug File",
        "icon": "$(debug-alt)"
      },
      {
        "command": "sfl.compileFile",
        "title": "SFL: Compile File to Native Executable"
      },
      {
        "command": "sfl.restartServer",
        "title": "SFL: Restart Language Server"
      },
      {
        "command": "sfl.projects.refresh",
        "title": "SFL: Reload Projects",
        "icon": "$(refresh)"
      },
      {
        "command": "sfl.projects.runTask",
        "title": "SFL: Run Task",
        "icon": "$(play)"
      },
      {
        "command": "sfl.projects.buildAll",
        "title": "SFL: Build All Projects",
        "icon": "$(run-all)"
      },
      {
        "command": "sfl.projects.openBuildFile",
        "title": "SFL: Open build.sfl",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sfl.projects.settings",
        "title": "SFL: Open Settings",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "file/newFile": [
        {
          "command": "sfl.newProject",
          "group": "file"
        }
      ],
      "editor/title/run": [
        {
          "command": "sfl.runFile",
          "when": "resourceLangId == sfl",
          "group": "navigation@1"
        },
        {
          "command": "sfl.debugFile",
          "when": "resourceLangId == sfl",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "sfl.runFile",
          "when": "resourceLangId == sfl"
        },
        {
          "command": "sfl.debugFile",
          "when": "resourceLangId == sfl"
        },
        {
          "command": "sfl.compileFile",
          "when": "resourceLangId == sfl"
        },
        {
          "command": "sfl.projects.runTask",
          "when": "false"
        },
        {
          "command": "sfl.projects.openBuildFile",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "sfl.projects.refresh",
          "when": "view == sflProjects",
          "group": "navigation@1"
        },
        {
          "command": "sfl.projects.buildAll",
          "when": "view == sflProjects",
          "group": "navigation@2"
        },
        {
          "command": "sfl.projects.settings",
          "when": "view == sflProjects",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "sfl.projects.runTask",
          "when": "view == sflProjects && viewItem == sflTask",
          "group": "inline"
        },
        {
          "command": "sfl.projects.runTask",
          "when": "view == sflProjects && viewItem == sflProject",
          "group": "inline"
        },
        {
          "command": "sfl.projects.openBuildFile",
          "when": "view == sflProjects && viewItem == sflProject",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "SFL",
      "properties": {
        "sfl.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `sfl` binary. Leave empty to use `sfl` (or `sfl.exe` on Windows) from PATH."
        },
        "sfl.home": {
          "type": "string",
          "default": "",
          "markdownDescription": "`SFL_HOME` for the language server, debugger and build tasks — the directory whose `libs/` and `packages/` imports search. GUI-launched editors do not inherit your shell's exports, so set it here if installed packages show as unresolved imports."
        },
        "sfl.diagnostics.undefinedNames": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Flag reads of variables that nothing defines (this file, its imports, or a builtin)."
        }
      }
    },
    "breakpoints": [
      {
        "language": "sfl"
      }
    ],
    "taskDefinitions": [
      {
        "type": "sfl",
        "properties": {
          "task": {
            "type": "string",
            "description": "The sfl build task to run (build, test, clean, or one defined in build.sfl)."
          },
          "project": {
            "type": "string",
            "description": "Project root to run in (defaults to the workspace folder)."
          }
        },
        "required": [
          "task"
        ]
      }
    ],
    "debuggers": [
      {
        "type": "sfl",
        "label": "SFL",
        "languages": [
          "sfl"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .sfl script to debug.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments passed to the script.",
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause on the first statement.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "sfl",
            "request": "launch",
            "name": "Debug SFL script",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "SFL: Debug current file",
            "body": {
              "type": "sfl",
              "request": "launch",
              "name": "Debug ${1:script}",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sfl",
          "title": "SFL",
          "icon": "media/sfl-activity.svg"
        }
      ]
    },
    "views": {
      "sfl": [
        {
          "id": "sflProjects",
          "name": "Projects",
          "icon": "media/sfl-activity.svg",
          "contextualTitle": "SFL Projects"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "sflProjects",
        "contents": "No build.sfl found in this workspace.\n[Create a Project](command:sfl.newProject)\n\nA project is a directory with a build.sfl; `sfl build init` scaffolds one."
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
