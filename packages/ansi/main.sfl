// ansi — terminal colours and styles as plain string functions.
//
//   import "ansi"
//
//   println(ansi.green("ok") + " " + ansi.bold("42ms"))
//   println(ansi.style("warning", "yellow", "bold", "underline"))
//   println(ansi.rgb("#ff8800 vibes", 255, 136, 0))
//
// Styling is a process-wide switch: it starts on unless the NO_COLOR
// environment variable is set or TERM is "dumb" (the conventions terminals
// agreed on), and setEnabled(false) turns every function here into the
// identity — so library code can colour unconditionally and let the caller
// decide once. strip removes any ANSI codes from a string, styled here
// or elsewhere.

val _codes = {
  reset: 0, bold: 1, dim: 2, italic: 3, underline: 4, blink: 5, inverse: 7,
  strikethrough: 9,
  black: 30, red: 31, green: 32, yellow: 33, blue: 34, magenta: 35, cyan: 36,
  white: 37, gray: 90, brightRed: 91, brightGreen: 92, brightYellow: 93,
  brightBlue: 94, brightMagenta: 95, brightCyan: 96, brightWhite: 97,
  bgBlack: 40, bgRed: 41, bgGreen: 42, bgYellow: 43, bgBlue: 44, bgMagenta: 45,
  bgCyan: 46, bgWhite: 47
}

val _ESC = chr(27)

var _enabled = getEnv("NO_COLOR") == null && getEnv("TERM") != "dumb"

def enabled() = _enabled

def setEnabled(on) {
  _enabled = on
  null
}

// Applies any number of style names: style("hi", "red", "bold").
def style(text, ...names) {
  if (!_enabled || isEmpty(names)) then return text
  val on = map(names, (n) -> {
    if (!contains(_codes, n)) {
      error("ansi: unknown style '" + n + "' (see keys(ansi.codes()))")
    }
    toString(_codes[n])
  })
  "[" + join(on, ";") + "m" + text + "[0m"
}

// The name -> SGR code table, for building custom sequences.
def codes() = copy(_codes)

def bold(text) = style(text, "bold")
def dim(text) = style(text, "dim")
def underline(text) = style(text, "underline")
def red(text) = style(text, "red")
def green(text) = style(text, "green")
def yellow(text) = style(text, "yellow")
def blue(text) = style(text, "blue")
def magenta(text) = style(text, "magenta")
def cyan(text) = style(text, "cyan")
def gray(text) = style(text, "gray")

// 256-colour foreground (0..255).
def color256(text, n) {
  if (!_enabled) then return text
  "[38;5;" + n + "m" + text + "[0m"
}

// 24-bit foreground.
def rgb(text, r, g, b) {
  if (!_enabled) then return text
  "[38;2;" + r + ";" + g + ";" + b + "m" + text + "[0m"
}

// Removes ANSI escape sequences (CSI ... final-byte), whoever put them there.
def strip(text) {
  var out = ""
  var i = 0
  val n = length(text)
  while (i < n) {
    val ch = charAt(text, i)
    if (ord(ch) == 27 && i + 1 < n && charAt(text, i + 1) == "[") {
      i += 2
      while (i < n) {
        val c = ord(charAt(text, i))
        i += 1
        if (c >= 0x40 && c <= 0x7e) then break   // the final byte ends the sequence
      }
    } else {
      out += ch
      i += 1
    }
  }
  out
}
