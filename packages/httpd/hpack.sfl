// The decode trie, built once at load: three parallel arrays where node k has
// children left[k]/right[k] (-1 when absent) and sym[k] is the decoded symbol
// (-1 on inner nodes, 256 for EOS). One node hop per input bit.
def _buildHuffTrie() {
  val left = [-1]
  val right = [-1]
  val sym = [-1]
  for (s in range(257)) {
    val code = _huffCodes[s]
    val bits = _huffBits[s]
    var node = 0
    var i = bits - 1
    while (i >= 0) {
      val one = bitAnd(shiftRightU(code, i), 1) == 1
      var next = if (one) then right[node] else left[node]
      if (next < 0) {
        push(left, -1)
        push(right, -1)
        push(sym, -1)
        next = length(sym) - 1
        if (one) then right[node] = next else left[node] = next
      }
      node = next
      i -= 1
    }
    sym[node] = s
  }
  {left: left, right: right, sym: sym}
}

val _huffTrie = _buildHuffTrie()

// Decodes bytes[from, until) of Huffman code into a string. Trailing bits that
// stop mid-path are the padding the RFC prescribes; a code that decodes to EOS
// is a coding error and raises.
def _huffDecode(bytes, from, until) {
  val lefts = _huffTrie.left
  val rights = _huffTrie.right
  val syms = _huffTrie.sym
  val out = []
  var node = 0
  var i = from
  while (i < until) {
    val b = bytes[i]
    var bit = 7
    while (bit >= 0) {
      node = if (bitAnd(shiftRightU(b, bit), 1) == 1) then rights[node] else lefts[node]
      if (node < 0) { error("hpack: invalid huffman code") }
      val s = syms[node]
      if (s >= 0) {
        if (s == 256) { error("hpack: EOS inside a huffman string") }
        push(out, s)
        node = 0
      }
      bit -= 1
    }
    i += 1
  }
  utf8Decode(out)
}

// ------------------------------------------------------------ primitive coding

// A prefix-N integer (RFC 7541 section 5.1) at bytes[i]: [value, nextIndex].
def _decInt(bytes, i, prefixBits) {
  if (i >= length(bytes)) { error("hpack: truncated integer") }
  val mask = shiftLeft(1, prefixBits) - 1
  var v = bitAnd(bytes[i], mask)
  var at = i + 1
  if (v < mask) { return [v, at] }
  var sh = 0
  while (true) {
    if (at >= length(bytes)) { error("hpack: truncated integer") }
    val b = bytes[at]
    at += 1
    v += shiftLeft(bitAnd(b, 127), sh)
    sh += 7
    if (b < 128) { return [v, at] }
    if (sh > 35) { error("hpack: integer overflow") }
  }
}

// Appends v as a prefix-N integer whose first byte carries `highBits` in the
// bits above the prefix.
def _encInt(out, highBits, prefixBits, v) {
  val mask = shiftLeft(1, prefixBits) - 1
  if (v < mask) {
    push(out, bitOr(highBits, v))
    return out
  }
  push(out, bitOr(highBits, mask))
  var rest = v - mask
  while (rest >= 128) {
    push(out, bitOr(bitAnd(rest, 127), 128))
    rest = shiftRightU(rest, 7)
  }
  push(out, rest)
  out
}

// A length-prefixed string at bytes[i]: [text, nextIndex]. The top bit of the
// length byte says whether the run is Huffman-coded.
def _decStr(bytes, i) {
  if (i >= length(bytes)) { error("hpack: truncated string") }
  val huff = bitAnd(bytes[i], 128) != 0
  val dec = _decInt(bytes, i, 7)
  val len = dec[0]
  val at = dec[1]
  if (at + len > length(bytes)) { error("hpack: truncated string") }
  val text = if (huff) then _huffDecode(bytes, at, at + len)
             else utf8Decode(slice(bytes, at, at + len))
  [text, at + len]
}

// Appends a string as a plain (H=0) literal.
def _encStr(out, s) {
  val bytes = utf8Encode(s)
  _encInt(out, 0, 7, length(bytes))
  pushBytes(out, bytes)
  out
}

// ------------------------------------------------------------------- decoder

// A connection's header decoder: one per HTTP/2 connection, fed every header
// block in wire order — HPACK state is shared across the whole connection.
// maxSize is SETTINGS_HEADER_TABLE_SIZE as this server advertised it.
def hpackDecoder(maxSize = 4096) {
  // Newest entry first; each entry [name, value] costs 32 octets plus the
  // UTF-8 lengths of both parts (RFC 7541 section 4.1).
  val state = {entries: [], size: 0, cap: maxSize, limit: maxSize}

  def entryCost(n, v) = utf8Length(n) + utf8Length(v) + 32

  def evictTo(target) {
    while (state.size > target && length(state.entries) > 0) {
      val gone = pop(state.entries)
      state.size -= entryCost(gone[0], gone[1])
    }
    null
  }

  def insert(n, v) {
    val cost = entryCost(n, v)
    evictTo(state.cap - cost)
    // An entry larger than the whole table just empties it (the RFC's rule).
    if (cost <= state.cap) {
      unshift(state.entries, [n, v])
      state.size += cost
    }
    null
  }

  def lookup(idx) {
    if (idx >= 1 && idx <= length(_staticTable)) { return _staticTable[idx - 1] }
    val d = idx - length(_staticTable) - 1
    if (d < 0 || d >= length(state.entries)) { error("hpack: index ${idx} out of range") }
    state.entries[d]
  }

  def decode(bytes) {
    val out = []
    var i = 0
    val n = length(bytes)
    while (i < n) {
      val b = bytes[i]
      if (bitAnd(b, 128) != 0) {
        // 1xxxxxxx -- indexed field.
        val r = _decInt(bytes, i, 7)
        if (r[0] == 0) { error("hpack: index zero") }
        i = r[1]
        val e = lookup(r[0])
        push(out, [e[0], e[1]])
      } else if (bitAnd(b, 192) == 64) {
        // 01xxxxxx -- literal with incremental indexing.
        val r = _decInt(bytes, i, 6)
        i = r[1]
        var name = null
        if (r[0] == 0) {
          val s = _decStr(bytes, i)
          name = s[0]
          i = s[1]
        } else {
          name = lookup(r[0])[0]
        }
        val v = _decStr(bytes, i)
        i = v[1]
        insert(name, v[0])
        push(out, [name, v[0]])
      } else if (bitAnd(b, 224) == 32) {
        // 001xxxxx -- dynamic table size update.
        val r = _decInt(bytes, i, 5)
        i = r[1]
        if (r[0] > state.limit) { error("hpack: size update ${r[0]} above the settings limit") }
        state.cap = r[0]
        evictTo(state.cap)
      } else {
        // 0000xxxx without indexing / 0001xxxx never indexed -- same wire shape.
        val r = _decInt(bytes, i, 4)
        i = r[1]
        var name = null
        if (r[0] == 0) {
          val s = _decStr(bytes, i)
          name = s[0]
          i = s[1]
        } else {
          name = lookup(r[0])[0]
        }
        val v = _decStr(bytes, i)
        i = v[1]
        push(out, [name, v[0]])
      }
    }
    out
  }

  // The settings limit moved (a new SETTINGS from us would do this; we keep it
  // fixed, so this exists for completeness and tests).
  def setLimit(n) {
    state.limit = n
    if (state.cap > n) {
      state.cap = n
      evictTo(n)
    }
    null
  }

  {decode: decode, setLimit: setLimit, size: () -> state.size, count: () -> length(state.entries)}
}

// ------------------------------------------------------------------- encoder

// The exact-match index for [name, value] in the static table, else the index
// with a matching name alone, else 0. Built once: name -> {value -> idx} and
// name -> first idx.
val _staticExact = {}
val _staticName = {}
for (i in range(length(_staticTable))) {
  val e = _staticTable[i]
  val key = "${e[0]} ${e[1]}"
  if (!contains(_staticExact, key)) { _staticExact[key] = i + 1 }
  if (!contains(_staticName, e[0])) { _staticName[e[0]] = i + 1 }
}

// Encodes [[name, value], ...] into a header block. Names must already be
// lowercase (HTTP/2 requires it; the h2 layer guarantees it for responses).
// `sensitive` names are emitted never-indexed so intermediaries keep them out
// of their tables too.
def hpackEncode(headers, sensitive = {}) {
  val out = []
  for (h in headers) {
    val name = h[0]
    val value = "${h[1]}"
    if (contains(sensitive, name)) {
      val ni = get(_staticName, name, 0)
      _encInt(out, 16, 4, ni)
      if (ni == 0) { _encStr(out, name) }
      _encStr(out, value)
    } else {
      val ei = get(_staticExact, "${name} ${value}", 0)
      if (ei != 0) {
        _encInt(out, 128, 7, ei)
      } else {
        val ni = get(_staticName, name, 0)
        _encInt(out, 0, 4, ni)
        if (ni == 0) { _encStr(out, name) }
        _encStr(out, value)
      }
    }
  }
  out
}
