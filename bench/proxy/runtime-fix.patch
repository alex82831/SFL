 SflThread *sfl_thread_self(void) { return self_thread; }
 
+/* ---- deadlock fix ---------------------------------------------------------
+ * The stopped world must never touch the C allocator: a thread parked by the
+ * stop signal can be holding a malloc arena lock, and the collector calling
+ * free()/realloc() on that arena then deadlocks the process (seen in the
+ * field: sweep's free() vs a thread parked inside sysmalloc). So while the
+ * world is stopped, side-buffer frees are deferred into an mmap-backed list
+ * drained after restart, and the mark stack grows by mmap, not realloc.
+ * Parked threads also wait on a futex instead of spinning sched_yield, so a
+ * collection no longer burns a core per parked thread.
+ */
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <linux/futex.h>
+#include <limits.h>
+#include <unistd.h>
+
+static void futex_wait_on(volatile int *addr, int val) {
+  syscall(SYS_futex, (int *)addr, FUTEX_WAIT_PRIVATE, val, NULL, NULL, 0);
+}
+static void futex_wake_all(volatile int *addr) {
+  syscall(SYS_futex, (int *)addr, FUTEX_WAKE_PRIVATE, INT_MAX, NULL, NULL, 0);
+}
+
+static void *gc_mmap(size_t bytes) {
+  void *p = mmap(NULL, bytes, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  return p == MAP_FAILED ? NULL : p;
+}
+
+static void **defer_frees;
+static size_t defer_len, defer_cap;
+static int defer_active;
+
+static void gc_defer_free(void *p) {
+  if (p == NULL) return;
+  if (defer_len == defer_cap) {
+    size_t ncap = defer_cap ? defer_cap * 2 : 8192;
+    void **nl = (void **)gc_mmap(ncap * sizeof(void *));
+    if (nl == NULL) { free(p); return; } /* cannot grow: accept the small risk */
+    if (defer_frees != NULL) {
+      memcpy(nl, defer_frees, defer_len * sizeof(void *));
+      munmap(defer_frees, defer_cap * sizeof(void *));
+    }
+    defer_frees = nl;
+    defer_cap = ncap;
+  }
+  defer_frees[defer_len++] = p;
+}
+
+static void gc_side_free(void *p) {
+  if (defer_active) gc_defer_free(p);
+  else free(p);
+}
+
+static void gc_drain_defer(void) {
+  for (size_t i = 0; i < defer_len; i++) free(defer_frees[i]);
+  defer_len = 0;
+}
+/* ------------------------------------------------------------------------- */
+
 /* Parks this thread until the collector is done with it. */
